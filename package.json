{
  "name": "syllabus-analyzer",
  "version": "1.0.0",
  "description": "Syllabus Analyzer and Knowledge Map generator",
  "main": "server.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
